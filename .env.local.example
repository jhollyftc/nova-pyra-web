# Copy to .env.local and fill in. Both are also set in the Vercel project's
# environment variables — change them in both places.
#
# Find these at https://sanity.io/manage -> your project -> API.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Only needed to run scripts/import-content.mjs, which writes to the dataset.
# Create at sanity.io/manage -> API -> Tokens, with Editor permissions.
# NEVER commit this. .env.local is gitignored.
SANITY_API_WRITE_TOKEN=
