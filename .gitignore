# dependencies
/node_modules
/.pnp
.pnp.*

# next.js
/.next/
/out/
next-env.d.ts
*.tsbuildinfo

# vercel
.vercel

# env
.env
.env*.local

# os / editor
.DS_Store
Thumbs.db

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# NOTE: /public is deliberately NOT ignored.
# It is generated by `npm run media`, but that script needs ffmpeg and a local
# checkout of ftc-pit-app, neither of which exists on Vercel's build machines —
# so the transcoded output has to be committed. ~85 MB, largest single file
# 16.5 MB (shooter-draco.glb), well inside GitHub's limits.
#
# /assets-src is also committed: it holds the team-supplied originals that
# `npm run media` processes, and they exist nowhere else.

.vercel
